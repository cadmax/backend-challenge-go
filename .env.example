# Somente desenvolvimento local. Nenhuma credencial abaixo deve ser usada em produção.
HTTP_PORT=8080
HTTP_PORT_2=8082
HTTP_PORT_3=8083
POSTGRES_PORT=55432
KEYCLOAK_PORT=8081
LOCALSTACK_PORT=4567

# Execução Go no host (o Compose usa nomes internos da rede).
HTTP_ADDR=:8080
DATABASE_URL=postgres://wager:wager-local@localhost:55432/wager?sslmode=disable
MIGRATION_DATABASE_URL=postgres://wager_owner:wager-owner-local@localhost:55432/wager?sslmode=disable
TEST_DATABASE_URL=postgres://wager_owner:wager-owner-local@localhost:55432/wager?sslmode=disable
OIDC_ISSUER_URL=http://localhost:8081/realms/jungle
OIDC_JWKS_URL=http://localhost:8081/realms/jungle/protocol/openid-connect/certs
OIDC_AUDIENCE=wagering-api
AWS_REGION=us-east-1
# No host, carregue as credenciais geradas: eval "$(./scripts/broker-env.sh app)"
SQS_ENDPOINT=http://localhost:4567
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_EVENT_QUEUE_NAME=wager-events.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo

WORKERS_ENABLED=true
REFERENCE_MAX_ATTEMPTS=8
REFERENCE_TTL=24h
REFERENCE_POLL_INTERVAL=1s
OUTBOX_POLL_INTERVAL=500ms
SQS_WAIT_SECONDS=10
SQS_VISIBILITY_SECONDS=30
PROCESS_TIMEOUT=10s
SHUTDOWN_TIMEOUT=20s
